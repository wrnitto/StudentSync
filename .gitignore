# ---------------------------------------------------------------
# StudentSync .gitignore
# ---------------------------------------------------------------

# Dependencies
node_modules/
jspm_packages/
.pnpm-store/
bower_components/

# Package manager logs / caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/cache/
.yarn/install-state.gz
.eslintcache
.stylelintcache

# Build output / generated files
dist/
build/
out/
.next/
.vite/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo
coverage/
.nyc_output/

# Environment files (commit .env.example only)
.env
.env.*
!.env.example
*.env.local

# Local database files and dumps
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-journal
database/local/
database/backups/
*.dump
pgdata/

# Logs
logs/
*.log

# Python (in case of helper scripts)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.AppleDouble
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Misc
*.tmp
*.bak
